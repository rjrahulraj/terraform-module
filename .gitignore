 # Terraform working directory and module cache
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Variable files containing secrets or environment-specific values
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
*.plan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration and credentials
.terraformrc
terraform.rc

# Terraform dependency lock file (uncomment if it should not be committed)
# .terraform.lock.hcl

# Module/package archives
*.zip
*.tar
*.tar.gz
